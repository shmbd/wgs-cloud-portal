# ============================================================================
# BioForge WGS Cloud Portal — Environment Variables
# Set these in Netlify UI: Site configuration -> Environment variables
# (Scope: Functions + Builds)
# ============================================================================

# 1. Portal Security
PORTAL_PASSCODE=change-this-lab-password
WEBHOOK_SECRET=generate-a-random-32-char-secret-shared-with-github

# 2. GitHub Actions Compute Trigger
# Repository in "owner/repo" format where .github/workflows/wgs-pipeline.yml lives
GITHUB_REPO=your-github-username/wgs-cloud-portal
# Fine-grained Personal Access Token with "Actions: Read and write" permission on GITHUB_REPO
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_BRANCH=main

# 3. Cloudflare R2 Object Storage (10 GB Free Tier, $0 Egress)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wgs-pipeline-storage
